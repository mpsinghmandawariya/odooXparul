    print("="*60)
    print("  TRAVELOOP PREMIUM UI - STARTING")
    print("="*60)
    print()
    print("  Open: http://127.0.0.1:5000")
    print("  Premium UI is active!")
    print()
    print("="*60)
    app.run(debug=True, port=5000)
